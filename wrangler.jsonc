{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "roughlogic-reports",
  "main": "report-worker.mjs",
  "compatibility_date": "2026-05-06",
  "workers_dev": false,
  "preview_urls": false,
  "secrets": {
    "required": ["TURNSTILE_SECRET_KEY", "REPORT_HASH_SECRET"]
  },
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "roughlogic.com/api/reports*",
      "zone_name": "roughlogic.com"
    }
  ],
  "vars": {
    "TURNSTILE_SITE_KEY": "0x4AAAAAAEZVderfD5yAGmMV",
    "REPORT_ALLOWED_ORIGINS": "https://roughlogic.com",
    "REPORT_DAILY_LIMIT": "200",
    "REPORT_REPORTER_DAILY_LIMIT": "5"
  },
  "d1_databases": [
    {
      "binding": "REPORTS_DB",
      "database_name": "roughlogic-reports",
      "database_id": "bcfc7e44-6f0f-4904-8e03-96a1c964956a",
      "migrations_dir": "migrations"
    }
  ]
}
